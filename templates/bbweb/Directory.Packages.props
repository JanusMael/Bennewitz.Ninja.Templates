<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Versioning">
    <PackageVersion Include="Bennewitz.Ninja.AutoVersioning" Version="2026.4.1031" />
  </ItemGroup>

  <ItemGroup Label="Analysis">
    <!-- Microsoft.VisualStudio.Threading.Analyzers, for two of its rules; Directory.Build.props
         says which and turns the rest off. -->
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.12.1" />
    <!-- Bennewitz.Ninja.CodeQuality, every rule at its default; Directory.Build.props says why. A
         move here can bring new rules, so a raise is built before it lands. -->
    <PackageVersion Include="Bennewitz.Ninja.CodeQuality" Version="2026.4.1113" />
  </ItemGroup>

  <ItemGroup Label="Family">
    <!-- The entry point: an unhandled exception reported on stderr and exit 1, and the version flag
         answered before the host is built. References nothing beyond the framework. -->
    <PackageVersion Include="Bennewitz.Ninja.AppServices.EntryPoint" Version="2026.4.1116" />
  </ItemGroup>

  <ItemGroup Label="Logging">
    <!-- Serilog renders every log line, plugged into Microsoft.Extensions.Logging by its hosting
         bridge; src/SiteStem/AppLog.cs says how. Serilog moves with AppServices.Logging's pin, and the
         bridge stays on the 10.0 line, the Microsoft.Extensions version the ASP.NET Core runtime
         brings: its 11.0 line takes Microsoft.Extensions 11. -->
    <PackageVersion Include="Serilog" Version="4.3.1" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <!-- The in-memory host that runs the real Program for the tests. Keep it on the same 10.0
         servicing line as the ASP.NET Core runtime the SDK in global.json brings. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <!-- xunit.v3 on Microsoft.Testing.Platform — see global.json. The VSTest bridge packages are
         deliberately absent, and so is TrxReport: nothing asks for a .trx, and it would have to
         match the platform version xunit takes on every bump. -->
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="Bennewitz.Ninja.AssemblyQuality" Version="2026.4.1031" />
  </ItemGroup>
</Project>
