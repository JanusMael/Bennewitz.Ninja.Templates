<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Versioning">
    <PackageVersion Include="Bennewitz.Ninja.AutoVersioning" Version="2026.3.928" />
  </ItemGroup>
<!--#if (Analyzer) -->

  <PropertyGroup Label="Roslyn">
    <!-- ⚠ The oldest compiler a consumer can use: an analyzer compiled against Roslyn X loads in
         every compiler X or later and in none before it. 4.14.0 is the family's, by the
         maintainer's choice on 2026-09-25, the version Bennewitz.Ninja.AutoVersioning and
         Bennewitz.Ninja.CodeQuality are built against. Move it up only for an API the rules cannot
         do without, and down only with every rule built and tested on the lower one. The tests
         resolve the same version through Microsoft.CodeAnalysis.CSharp.Workspaces, so the rules
         are proved on the oldest compiler the package claims to support. -->
    <RoslynVersion>4.14.0</RoslynVersion>
  </PropertyGroup>

  <ItemGroup Label="Roslyn">
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="$(RoslynVersion)" />
    <!-- ⛔ The testing package floors this at 1.0.1 and raises it for nobody; without this pin the
         tests restore a 2015 Workspaces (NU1701) and run the analyzer on nothing like a consumer's
         compiler. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="$(RoslynVersion)" />
    <!-- The rules for analyzer authors (RS****). Build-time only; the newest is fine. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.4" />
    <!-- ⛔ Pinned through transitive pinning, for the tests alone: Analyzer.Testing 1.1.4 reaches it
         through NuGet.Packaging 7.0.3 at 9.0.6, which GHSA-2fmv-rv2c-59x7 (moderate) and
         GHSA-846f-f764-76mx (high), both published 2026-10-13, make a restore error. Both are
         patched in 10.0.13. Remove the pin when Analyzer.Testing brings a patched one itself. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>
<!--#endif -->

  <ItemGroup Label="Testing">
    <!-- xunit.v3 on Microsoft.Testing.Platform — see global.json. The VSTest bridge packages are
         deliberately absent, and so is TrxReport: nothing asks for a .trx, and it would have to
         match the platform version xunit takes on every bump. -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="Bennewitz.Ninja.AssemblyQuality" Version="2026.3.929" />
  </ItemGroup>
</Project>
