<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Versioning">
    <PackageVersion Include="Bennewitz.Ninja.AutoVersioning" Version="2026.4.1031" />
  </ItemGroup>

  <ItemGroup Label="Analysis">
    <!-- Microsoft.VisualStudio.Threading.Analyzers, for two of its rules; Directory.Build.props
         says which and turns the rest off. -->
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.12.1" />
    <!-- Bennewitz.Ninja.CodeQuality, every rule at its default; Directory.Build.props says why. A
         move here can bring new rules, so a raise is built before it lands. -->
    <PackageVersion Include="Bennewitz.Ninja.CodeQuality" Version="2026.4.1111" />
  </ItemGroup>

  <ItemGroup Label="Avalonia">
    <!-- ⚠ Every Avalonia package moves together, Avalonia.Headless included. With transitive pinning
         on, one left behind is a restore error (NU1109) rather than a quiet mismatch. -->
    <PackageVersion Include="Avalonia" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.6" />
    <PackageVersion Include="Semi.Avalonia" Version="12.1.0.1" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup Label="Family">
    <!-- Logging (Serilog, a rolling file per hour, the Avalonia log bridge), the fatal-error dialog,
         and EntryPointOptions(), which connects both to the shared entry point.
         Bennewitz.Ninja.AppServices.Logging and .EntryPoint come with it. -->
    <PackageVersion Include="Bennewitz.Ninja.AppServices.Avalonia" Version="2026.4.1112" />
    <!-- The markup and assembly rules, run as tests. -->
    <PackageVersion Include="Bennewitz.Ninja.XamlQuality" Version="2026.4.1111" />
    <PackageVersion Include="Bennewitz.Ninja.AssemblyQuality" Version="2026.4.1031" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <!-- xunit.v3 on Microsoft.Testing.Platform — see global.json. The VSTest bridge packages are
         deliberately absent, and so is TrxReport: nothing asks for a .trx, and it would have to
         match the platform version xunit takes on every bump. -->
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
</Project>
