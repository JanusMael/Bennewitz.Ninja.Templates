<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Bennewitz.Ninja.AppStem.ViewModels"
        x:Class="Bennewitz.Ninja.AppStem.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="AppStem"
        Width="480" Height="320"
        AutomationProperties.AutomationId="MainWindow">
  <!--
    Every interactive control carries an AutomationId, the stable handle a test or an agent finds it
    by, and a Name, what an automation client reads out. XamlQuality's BNXQ1002 fails the tests on an
    interactive control without a Name, and BNXQ1001 on an Expander without one. See
    docs/ai-drivable-ui.md in Bennewitz.Ninja.XamlQuality.
  -->
  <StackPanel Margin="24" Spacing="12">
    <TextBox x:Name="NameInput"
             Text="{Binding Name}"
             PlaceholderText="Name"
             AutomationProperties.AutomationId="NameInput"
             AutomationProperties.Name="Name" />

    <Button x:Name="GreetButton"
            Content="Greet"
            Command="{Binding GreetCommand}"
            IsDefault="True"
            AutomationProperties.AutomationId="GreetButton"
            AutomationProperties.Name="Greet" />

    <TextBlock x:Name="GreetingText"
               Text="{Binding Greeting}"
               AutomationProperties.AutomationId="GreetingText" />

    <Expander x:Name="AboutExpander"
              Header="About"
              AutomationProperties.AutomationId="AboutExpander"
              AutomationProperties.Name="About">
      <TextBlock Text="{Binding Version, StringFormat='Version {0}'}"
                 AutomationProperties.AutomationId="VersionText" />
    </Expander>
  </StackPanel>
</Window>
