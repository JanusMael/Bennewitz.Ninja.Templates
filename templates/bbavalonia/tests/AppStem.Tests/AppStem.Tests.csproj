<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <!-- The app itself, so the tests reach its view models and scan its compiled assembly. It is an
         executable; referencing it copies AppStem.dll here. -->
    <ProjectReference Include="../../src/AppStem/AppStem.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ⛔ No Avalonia.Headless here. A test that dispatches on the headless session belongs in
         AppStem.Headless.Tests, which isolates the session per assembly; without the package, one
         added here is a compile error rather than a quiet return of the per-test UIThread race. -->
    <PackageReference Include="Bennewitz.Ninja.XamlQuality" />
    <PackageReference Include="Bennewitz.Ninja.AssemblyQuality" />
  </ItemGroup>
</Project>
