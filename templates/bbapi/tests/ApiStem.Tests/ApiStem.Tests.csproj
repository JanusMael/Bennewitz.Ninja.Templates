<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!--
      ⛔ JSON serialisation by reflection off, as it is in the native binary. Without this the tests,
      which run under the JIT, fall back to reflection for a type missing from ApiJson and pass, while
      the native API answers that endpoint with a 500. Measured: a Greeting left out of ApiJson built
      clean with warnings as errors and passed every test until this was set.
    -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- The API itself, started in memory by WebApplicationFactory<Program>: the real pipeline and
         endpoints, under the JIT, with no port and no process. -->
    <ProjectReference Include="../../src/ApiStem/ApiStem.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>
</Project>
