<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Versioning">
    <PackageVersion Include="Bennewitz.Ninja.AutoVersioning" Version="2026.3.928" />
  </ItemGroup>

  <ItemGroup Label="API">
    <!-- The OpenAPI document at /openapi/v1.json, generated at build time and AOT-safe. Keep it on
         the same 10.0 servicing line as the ASP.NET Core runtime. -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Family">
    <!-- The entry point: an unhandled exception reported on stderr and exit 1, and the version flag
         answered before the host is built. References nothing beyond the framework, and is native
         AOT compatible. -->
    <PackageVersion Include="Bennewitz.Ninja.AppServices.EntryPoint" Version="2026.4.1001" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <!-- The in-memory host that runs the real Program for the tests. Keep it on the same 10.0
         servicing line as the ASP.NET Core runtime the SDK in global.json brings. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <!-- xunit.v3 on Microsoft.Testing.Platform — see global.json. The VSTest bridge packages are
         deliberately absent, and so is TrxReport: nothing asks for a .trx, and it would have to
         match the platform version xunit takes on every bump. -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="Bennewitz.Ninja.AssemblyQuality" Version="2026.3.929" />
  </ItemGroup>
</Project>
