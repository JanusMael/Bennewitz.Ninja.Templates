<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Versioning">
    <PackageVersion Include="Bennewitz.Ninja.AutoVersioning" Version="2026.3.914" />
  </ItemGroup>

  <ItemGroup Label="Tools">
    <!-- scripts/mstest-to-xunit.cs. File-based apps honour central package management, so the
         script's `#:package` carries no version (NU1008 otherwise) and the pin lives here.
         5.x parses C# 14 and `preview`, which the suites it converts are written in. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <!-- xunit.v3 on Microsoft.Testing.Platform — see global.json. The VSTest bridge packages are
         deliberately absent; TrxReport is what gives CI its .trx files.

         ⭐ The same framework the template SHIPS, and that is the reason rather than a preference:
         this repository's own tests and the skeleton's under templates/bbpkg/ are read side by
         side constantly, and one of them switching idiom would make every comparison harder than
         the choice is worth. -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <!-- ⚠ Same Microsoft.Testing.Platform line as xunit.v3 3.2.2 (1.9.1). A NEWER TrxReport pins
         the platform above what xunit's bundled MSBuild extension can load, and the failure reads
         as an unrelated loader error. -->
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="1.9.1" />
  </ItemGroup>
</Project>
