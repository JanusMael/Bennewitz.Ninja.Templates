<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Versioning">
    <PackageVersion Include="Bennewitz.Ninja.AutoVersioning" Version="2026.4.1031" />
  </ItemGroup>

  <ItemGroup Label="Analysis">
    <!-- Microsoft.VisualStudio.Threading.Analyzers, for two of its rules; Directory.Build.props
         says which and turns the rest off. -->
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.12.1" />
    <!-- Bennewitz.Ninja.CodeQuality, every rule at its default; Directory.Build.props says why. A
         move here can bring new rules, so a raise is built before it lands. -->
    <PackageVersion Include="Bennewitz.Ninja.CodeQuality" Version="2026.4.1113" />
  </ItemGroup>

  <ItemGroup Label="Tools">
    <!-- scripts/mstest-to-xunit.cs. File-based apps honour central package management, so the
         script's `#:package` carries no version (NU1008 otherwise) and the pin lives here.
         5.x parses C# 14 and `preview`, which the suites it converts are written in. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <!-- xunit.v3 on Microsoft.Testing.Platform — see global.json. The VSTest bridge packages are
         deliberately absent, and so is TrxReport: nothing asks for a .trx, and it would have to
         match the platform version xunit takes on every bump.

         ⭐ The same framework the template SHIPS, and that is the reason rather than a preference:
         this repository's own tests and the skeleton's under templates/bbpkg/ are read side by
         side constantly, and one of them switching idiom would make every comparison harder than
         the choice is worth. -->
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
</Project>
